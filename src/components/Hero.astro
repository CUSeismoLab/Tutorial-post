---
import { Image } from 'astro:assets';
import { LinkButton } from '@astrojs/starlight/components';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [], image } = data.hero || {};
const source = image && 'file' in image ? image.file : undefined;
---

<div class="hero">
  <div class="hero-copy">
    <p class="hero-label">CUHK · SEISMOLOGY TUTORIALS</p>
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <div class="tagline" set:html={tagline} />}
    <div class="hero-actions">
      {actions.map(({ link, text, variant, icon }) => (
        <LinkButton href={link} variant={variant} icon={icon?.type === 'icon' ? icon.name : undefined}>{text}</LinkButton>
      ))}
    </div>
  </div>
  {source && <Image src={source} width={640} alt={image?.alt || ''} loading="eager" fetchpriority="high" />}
</div>

<style>
  .hero { display: grid; grid-template-columns: 1.25fr 1fr; align-items: center; }
  .hero-copy { display: flex; flex-direction: column; gap: 1.5rem; }
  .hero-label { color: var(--sl-color-accent-high); font-size: 0.7rem; letter-spacing: 0.16em; font-weight: 700; }
  h1 { color: var(--sl-color-white); font-weight: 650; }
  .tagline { color: var(--sl-color-gray-2); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 0.5rem; }
  @media (max-width: 50rem) {
    .hero { grid-template-columns: 1fr; }
    .hero > img { max-width: 30rem; margin-inline: auto; }
  }
</style>
